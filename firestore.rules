rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions de rôle ─────────────────────────────────────────────────
    function isBootstrapAdmin() {
      return request.auth != null &&
        request.auth.token.email.lower() in ['apotrepaulabba@gmail.com'];
    }
    function isAdmin() {
      return request.auth != null && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }
    function isMentor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/mea_mentors/$(request.auth.token.email.lower()));
    }
    // Le mentor est-il assigné à ce bâtisseur (uid) ?
    function isMentorOf(batisseurUid) {
      return request.auth != null && isMentor() &&
        get(/databases/$(database)/documents/mea_assignments/$(batisseurUid)).data.mentorEmail
          == request.auth.token.email.lower();
    }

    // ── Collections existantes (ABBA Life + Parcours — inchangées) ────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();

      match /priv/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow write: if isAdmin() && doc == "binome";

        // PDP et rencontres : le mentor assigné peut lire (pas écrire)
        allow read: if isMentorOf(uid) && (doc == "mea_pdp" || doc == "mea_rencontres");
      }

      match /months/{monthKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /summaries/{uid} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /binomes/{pairId} {
      allow read: if isAdmin() || (request.auth != null &&
        request.auth.token.email.lower() in [resource.data.membre1, resource.data.membre2]);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null &&
        request.auth.token.email.lower() in [resource.data.membre1, resource.data.membre2]);
    }

    match /seances/{seanceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Nouvelles collections — Mise en Action ────────────────────────────

    // Mentors : liste gérée par les admins
    match /mea_mentors/{email} {
      allow read: if request.auth != null; // tout utilisateur connecté peut vérifier son statut
      allow write: if isAdmin();
    }

    // Assignments batisseur → mentor : écrit par admin, lu par admin, mentor et bâtisseur concerné
    match /mea_assignments/{batisseurUid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == batisseurUid)
        || (isMentor() && resource.data.mentorEmail == request.auth.token.email.lower());
      allow write: if isAdmin();
    }

    // Résumés Mise en Action : écrits par le bâtisseur ou l'admin, lus par admin et mentor assigné.
    // Le champ mentorEmail dans le document permet au mentor de filtrer sans lire mea_assignments.
    match /mea_summaries/{batisseurUid} {
      allow write: if isAdmin()
        || (request.auth != null && request.auth.uid == batisseurUid);
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == batisseurUid)
        || (isMentor() && resource.data.mentorEmail == request.auth.token.email.lower());
    }
  }
}
