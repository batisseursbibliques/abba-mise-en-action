rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions de rôle ─────────────────────────────────────
    function isBootstrapAdmin() {
      return request.auth != null &&
        request.auth.token.email.lower() in ['apotrepaulabba@gmail.com'];
    }
    function isAdmin() {
      return request.auth != null && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }
    function isMentor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/mea_mentors/$(request.auth.token.email.lower()));
    }
    function isMentorOf(batisseurUid) {
      return request.auth != null && isMentor() &&
        get(/databases/$(database)/documents/mea_assignments/$(batisseurUid)).data.mentorEmail
          == request.auth.token.email.lower();
    }

    // ── Utilisateurs ──────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();

      match /priv/{doc} {
        // Propriétaire : accès total à ses propres docs
        allow read, write: if request.auth != null && request.auth.uid == uid;
        // Admin : lecture totale + écriture binôme
        allow read: if isAdmin();
        allow write: if isAdmin() && doc == "binome";
        // Mentor assigné : lecture PDP et rencontres uniquement
        allow read: if isMentorOf(uid) && (doc == "mea_pdp" || doc == "mea_rencontres");
      }

      match /months/{monthKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Résumés ABBA Life (summaries) ─────────────────────────
    match /summaries/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ── Configuration (modules, zones) ────────────────────────
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Administrateurs dynamiques ────────────────────────────
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Binômes Parcours Bâtisseur ────────────────────────────
    match /binomes/{pairId} {
      allow read: if isAdmin() || (request.auth != null &&
        request.auth.token.email.lower() in [resource.data.membre1, resource.data.membre2]);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null &&
        request.auth.token.email.lower() in [resource.data.membre1, resource.data.membre2]);
    }

    // ── Séances Parcours Bâtisseur ────────────────────────────
    match /seances/{seanceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Enrollment — accès contrôlé ───────────────────────────
    match /enrollments/{enrollId} {
      allow read: if isAdmin()
        || (request.auth != null && enrollId.matches(request.auth.uid + '_.*'));
      allow create: if request.auth != null
        && enrollId.matches(request.auth.uid + '_.*')
        && request.resource.data.status == "pending";
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Mise en Action — Mentors ──────────────────────────────
    match /mea_mentors/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Mise en Action — Assignments ──────────────────────────
    match /mea_assignments/{batisseurUid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == batisseurUid)
        || (isMentor() && resource.data.mentorEmail == request.auth.token.email.lower());
      allow write: if isAdmin();
    }

    // ── Mise en Action — Résumés ──────────────────────────────
    match /mea_summaries/{batisseurUid} {
      allow write: if isAdmin()
        || (request.auth != null && request.auth.uid == batisseurUid);
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == batisseurUid)
        || (isMentor() && resource.data.mentorEmail == request.auth.token.email.lower());
    }
  }
}
